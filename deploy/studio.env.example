# Copy to a private runtime env file (chmod 0600); replace every placeholder.
# Dedicated runtime role: DML only, no schema ownership.
STUDIO_DATABASE_URL=postgresql+psycopg://studio_app:REPLACE_ME@DB_HOST:5432/flamoris_studio
# Use a protected HTTPS endpoint, or a trusted local tunnel to a loopback-only
# Generation MCP listener. Empty means unavailable.
STUDIO_GENERATION_ENDPOINT=
# Direct Generation: leave namespace empty. Hub endpoint: set generation.
STUDIO_GENERATION_NAMESPACE=
# Backend-only Bearer token for the protected endpoint; never place it in browser config.
STUDIO_GENERATION_TOKEN=
# Optional operator-provisioned one-to-one external client grants. Every row is
# {"user_id":"EXISTING_STUDIO_UUID","issuer":"HUB_ISSUER","subject":"CLIENT_SUBJECT"}.
# Private backend configuration; [] disables external generation import.
STUDIO_EXTERNAL_BINDINGS=[]
# Enable only with matching Generation v3 profile/catalog and an exact ready root.
STUDIO_GENERATION_V3_ENABLED=false
# Optional scoped Agent assistant: private direct Agent MCP endpoint/Bearer token.
# Map existing Studio account UUIDs to exact operator-granted tuples privately.
STUDIO_AGENT_ENDPOINT=
STUDIO_AGENT_TOKEN=
STUDIO_AGENT_BINDINGS=[]
# Optional raw Intelligence editor; verify actual local provider before enabling.
STUDIO_INTELLIGENCE_ENDPOINT=
STUDIO_INTELLIGENCE_TOKEN=
STUDIO_INTELLIGENCE_DATA_FLOW=
STUDIO_INTELLIGENCE_MODELS=[]
STUDIO_THUMBNAIL_DIR=/data/thumbnails
STUDIO_WEB_DIST=/app/web/dist
STUDIO_ALLOW_REGISTRATION=0
# Exact reverse proxy source IP/CIDR as observed by the container. Docker host
# nginx usually connects from the bridge gateway: configure that IP explicitly.
# Empty disables forwarded headers. Wildcards are rejected.
STUDIO_TRUSTED_PROXY_IPS=127.0.0.1,::1
STUDIO_WORKERS=1
STUDIO_MAX_ASSET_BYTES=67108864
# Managed-input metadata rows and independent thumbnail bytes, including
# uncertain creates and tombstones pending confirmed cleanup.
STUDIO_INPUT_USER_ROWS=128
STUDIO_INPUT_GLOBAL_ROWS=1024
STUDIO_INPUT_USER_BYTES=33554432
STUDIO_INPUT_GLOBAL_BYTES=134217728
# Never set STUDIO_DEV_INSECURE_COOKIE in production.
